{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "dndcampaign",
    "Audience": "dndcampaign-users"
    // "Key" is intentionally omitted here. Supply it at runtime via the
    // environment variable  Jwt__Key  (e.g. in Render's dashboard). The app
    // fails to start if it's missing, which is what we want in production.
  }
}
